# =====================================================================
#  euclid.mplstyle — Euclid Consortium papers (A&A), in the look of niceplots
#
#  The look of this style is adapted from "niceplots", the Euclid
#  Consortium Editorial Board's matplotlib style for Euclid papers
#  (euclid_stylesheet v2, set up by Lukas Hergt with tweaks by Laila
#  Linke; GPL-3.0; https://gitlab.euclid-sgs.uk/ECEB/niceplots,
#  Euclid-internal). Its settings are re-expressed in plotastro's own
#  template; no file or code from niceplots is included. Parameters that
#  niceplots leaves at matplotlib's defaults are written out here so that
#  switching from another plotastro style is clean. Two plotastro
#  additions that do not change the look: constrained layout (niceplots'
#  finalizePlot() calls tight_layout() instead) and Type-42 font
#  embedding for submission-safe PDFs.
#
#  Figure widths:
#      drawn 4.00 in = 289.08 pt wide and scaled by LaTeX into
#      the 88 mm A&A column; two columns: 8.00 in = 578.16 pt
#      (niceplots' convention, see the note below)
#  niceplots' convention is to draw every figure 4.0 x 3.0 in with 10 pt
#  lettering and let LaTeX scale it into the 88 mm A&A column, where it
#  prints at ~8.7 pt; a two-column figure is drawn twice as large.
#  plotastro.figsize() / subplots() follow that convention for this
#  style. For a figure at its exact printed size instead, keep the style
#  and size it for A&A: plotastro.subplots(journal="aanda").
#
#  Colours: Petroff (2021) 8-colour palette (plotastro.PETROFF8),
#  niceplots' default. Its other schemes: plotastro.euclid_colors() or
#  plotastro.set_style("euclid", palette="categorical3").
#  Generated by tools/generate_styles.py — edit that, not this file.
#
#  Usage:   import plotastro; plotastro.set_style("euclid")
#     or:   import plotastro; plt.style.use("euclid")
# =====================================================================

## ---- Lines & markers ------------------------------------------------
lines.linewidth       : 1.0
lines.markersize      : 5.0
lines.markeredgewidth : 1.0      # matplotlib default
errorbar.capsize      : 0        # matplotlib default
patch.linewidth       : 1.0      # matplotlib default

## ---- Fonts: sans-serif text, Computer Modern maths ------------------
font.family      : sans-serif
font.sans-serif  : DejaVu Sans, Bitstream Vera Sans, Computer Modern Sans Serif, Lucida Grande, Verdana, Geneva, Lucid, Arial, Helvetica, Avant Garde, sans-serif
font.serif       : DejaVu Serif, Bitstream Vera Serif, Computer Modern Roman, New Century Schoolbook, Century Schoolbook L, Utopia, ITC Bookman, Bookman, Nimbus Roman No9 L, Times New Roman, Times, Palatino, Charter, serif   # matplotlib default
font.size        : 10
mathtext.fontset : cm            # Computer Modern, like LaTeX's default maths

# niceplots turns LaTeX on whenever a `latex` binary is found; text is then
# set in Computer Modern Sans (matplotlib adds \sffamily itself, so no
# preamble is needed). Same thing: plotastro.set_style("euclid", usetex=True).
#text.usetex : True

## ---- Axes -----------------------------------------------------------
axes.linewidth             : 0.6
axes.facecolor             : white
axes.labelsize             : medium
axes.titlesize             : large
axes.labelpad              : 4.0     # matplotlib default
axes.axisbelow             : line    # matplotlib default
axes.formatter.use_mathtext: False   # matplotlib default
axes.xmargin               : 0       # data spans the full x range
axes.ymargin               : 0.05    # matplotlib default

# Petroff (2021) 8-colour palette — plotastro.PETROFF8
axes.prop_cycle : cycler('color', ['1845fb', 'ff5e02', 'c91f16', 'c849a9', 'adad7d', '86c8dd', '578dff', '656364'])

## ---- Grid: off, as in niceplots (set_style(grid=True) for a subtle one)
axes.grid      : False
grid.linewidth : 0.4
grid.alpha     : 0.25

## ---- Ticks: all four sides, pointing in, no minors ------------------
xtick.direction     : in
xtick.top           : True
xtick.bottom        : True
xtick.minor.visible : False
xtick.major.size    : 2.5
xtick.minor.size    : 1.5
xtick.major.width   : 0.6
xtick.minor.width   : 0.4
xtick.major.pad     : 5.0
xtick.labelsize     : medium

ytick.direction     : in
ytick.left          : True
ytick.right         : True
ytick.minor.visible : False
ytick.major.size    : 2.5
ytick.minor.size    : 1.5
ytick.major.width   : 0.6
ytick.minor.width   : 0.4
ytick.major.pad     : 5.0
ytick.labelsize     : medium

## ---- Legend: matplotlib's defaults (framed) -------------------------
legend.fontsize       : medium
legend.title_fontsize : None
legend.frameon        : True
legend.handlelength   : 2.0
legend.handletextpad  : 0.8
legend.labelspacing   : 0.5
legend.columnspacing  : 2.0
legend.borderaxespad  : 0.5

## ---- Figure ---------------------------------------------------------
figure.figsize                : 4.0, 3.0   # niceplots' 4:3 default (see header)
figure.dpi                    : 200         # on-screen / notebook display
figure.titlesize              : large       # matplotlib default
figure.constrained_layout.use : True        # plotastro addition (see header)

## ---- Images ---------------------------------------------------------
image.cmap : viridis      # matplotlib default
#image.origin : lower    # uncomment for the astro image convention

## ---- Saving ---------------------------------------------------------
savefig.format     : pdf
savefig.dpi        : 300      # for raster formats
savefig.bbox       : tight
savefig.pad_inches : 0.02
pdf.fonttype       : 42       # plotastro addition: embed TrueType fonts (no Type-3)
ps.fonttype        : 42
